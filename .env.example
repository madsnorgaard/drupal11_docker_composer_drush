# Copy this file to .env and fill in real values. The .env file is git-ignored;
# this example is committed so a fresh clone knows which variables to set.

# Database (the MariaDB service). DB_HOST is the compose service name.
DB_NAME=drupal
DB_USER=drupal
DB_PASS=change-me
DB_HOST=madsnorgaard_drupal_db
DB_PORT=3306

# Drupal core
# Generate a salt with:
#   docker compose exec -T drupal drush php:eval "echo \Drupal\Component\Utility\Crypt::randomBytesBase64(55);"
HASH_SALT=change-me-to-a-long-random-string
DOMAIN_NAME=drupal.localhost
TRUSTED_HOST_PATTERNS=^drupal\.localhost$
WEBROOT_SITE=web

# Redis cache backend
REDIS_HOST=madsnorgaard_redis
REDIS_PORT=6379
REDIS_PASSWORD=

# Optional: Config Split (requires drupal/config_split)
#CONFIG_SPLIT_DEVELOPMENT=false

# Optional: SMTP mail (requires drupal/smtp)
#SMTP_HOST=
#SMTP_PORT=587
#SMTP_USER=
#SMTP_PASSWORD=
#SMTP_PROTOCOL=tls

# Optional: Solr search (requires drupal/search_api_solr)
#SOLR_HOST=madsnorgaard_solr
#SOLR_PORT=8983
#SOLR_CORE=dev
